<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    
    <!-- SEO Meta Tags -->
    <title>AKSHAYA — Full-Stack Developer & Accessibility Advocate</title>
    <meta name="description" content="Portfolio of AKSHAYA, a full-stack software engineer specializing in accessible web applications, modern HTML5 semantics, and high-performance UX.">
    <meta name="keywords" content="Full-Stack Developer, Web Accessibility, HTML5, WCAG, Frontend Engineer, Portfolio">
    <meta name="author" content="AKSHAYA">
    
    <!-- Open Graph Social Tags -->
    <meta property="og:title" content="AKSHAYA — Full-Stack Developer">
    <meta property="og:description" content="Explore accessible web design, projects, and professional experience.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.akshaya.dev">
    <meta property="og:image" content="https://www.akshaya.dev/assets/og-image.jpg">

    <!-- Favicon -->
    <link rel="icon" href="favicon.ico" type="image/x-icon">

    <!-- Combined Embedded CSS -->
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --text-main: #1f2937;
            --bg-main: #ffffff;
            --focus-ring: 3px solid #2563eb;
            --border-color: #d1d5db;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: var(--text-main);
            background-color: var(--bg-main);
            line-height: 1.6;
        }

        /* Skip Link */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--primary);
            color: white;
            padding: 8px 16px;
            z-index: 100;
            transition: top 0.2s ease-in-out;
            font-weight: 600;
        }

        .skip-link:focus {
            top: 0;
        }

        /* Focus Visible Standards */
        a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
            outline: var(--focus-ring);
            outline-offset: 2px;
        }

        /* Screen Reader Only Utility */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* Header & Navigation */
        .site-header {
            padding: 1.5rem 0;
            border-bottom: 1px solid #e5e7eb;
        }

        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-weight: 700;
            font-size: 1.25rem;
            text-decoration: none;
            color: var(--text-main);
        }

        .nav-list {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        .nav-list a {
            text-decoration: none;
            color: var(--text-main);
            font-weight: 500;
        }

        .nav-list a[aria-current="page"] {
            color: var(--primary);
            font-weight: 700;
        }

        /* Main Sections */
        .hero {
            padding: 5rem 0;
        }

        .hero-content {
            max-width: 800px;
        }

        .hero-content h1 {
            font-size: 3rem;
            margin: 0.5rem 0 1rem 0;
            line-height: 1.2;
        }

        .sub-heading {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--primary);
        }

        .lead {
            font-size: 1.2rem;
            color: #4b5563;
            margin-bottom: 2rem;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
        }

        /* Contact Section */
        .contact-section {
            padding: 4rem 0;
        }

        .section-header {
            margin-bottom: 2rem;
        }

        .section-header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        .contact-form {
            max-width: 600px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .required {
            color: #dc2626;
        }

        input[type="text"],
        input[type="email"],
        textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-size: 1rem;
        }

        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .btn-secondary {
            background-color: #f3f4f6;
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            background-color: #e5e7eb;
        }

        /* Footer */
        .site-footer {
            padding: 2rem 0;
            border-top: 1px solid #e5e7eb;
            margin-top: 4rem;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .social-links {
            display: flex;
            list-style: none;
            gap: 1.5rem;
        }

        .social-links a {
            color: var(--text-main);
            text-decoration: none;
        }

        .social-links a:hover {
            color: var(--primary);
        }

        @media (max-width: 768px) {
            .footer-inner {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- Skip Link for Keyboard & Screen Reader Users -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Global Site Header -->
    <header class="site-header" role="banner">
        <div class="container header-inner">
            <a href="#main-content" class="logo" aria-label="AKSHAYA - Home">
                <span aria-hidden="true">&lt;A /&gt;</span>
            </a>

            <!-- Primary Navigation Landmark -->
            <nav class="site-nav" role="navigation" aria-label="Main Navigation">
                <ul class="nav-list" role="list">
                    <li><a href="#home" aria-current="page">Home</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#projects">Projects</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Main Content Landmark -->
    <main id="main-content" tabindex="-1">
        
        <!-- Hero Section -->
        <section id="home" class="hero" aria-labelledby="hero-heading">
            <div class="container">
                <div class="hero-content">
                    <span class="sub-heading" aria-hidden="true">Hello, my name is</span>
                    <h1 id="hero-heading">AKSHAYA</h1>
                    <p class="lead">I build inclusive, high-performance, and human-centered web experiences.</p>
                    <div class="hero-actions">
                        <a href="#projects" class="btn btn-primary">Explore Projects</a>
                        <a href="#contact" class="btn btn-secondary">Get in Touch</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Accessible Contact Form Section -->
        <section id="contact" class="contact-section" aria-labelledby="contact-heading">
            <div class="container contact-container">
                <header class="section-header">
                    <h1 id="contact-heading">Let's Work Together</h1>
                    <p>Have a project in mind or want to discuss accessibility? Fill out the tab-navigable form below.</p>
                </header>

                <form id="contact-form" class="contact-form" action="#" method="POST" novalidate>
                    
                    <div class="form-group">
                        <label for="name">Full Name <span aria-hidden="true" class="required">*</span></label>
                        <input type="text" id="name" name="name" required aria-required="true" autocomplete="name" aria-describedby="name-error">
                        <span id="name-error" class="error-message" aria-live="polite"></span>
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address <span aria-hidden="true" class="required">*</span></label>
                        <input type="email" id="email" name="email" required aria-required="true" autocomplete="email" aria-describedby="email-error">
                        <span id="email-error" class="error-message" aria-live="polite"></span>
                    </div>

                    <div class="form-group">
                        <label for="subject">Subject <span aria-hidden="true" class="required">*</span></label>
                        <input type="text" id="subject" name="subject" required aria-required="true" aria-describedby="subject-error">
                        <span id="subject-error" class="error-message" aria-live="polite"></span>
                    </div>

                    <div class="form-group">
                        <label for="message">Your Message <span aria-hidden="true" class="required">*</span></label>
                        <textarea id="message" name="message" rows="5" required aria-required="true" aria-describedby="message-error"></textarea>
                        <span id="message-error" class="error-message" aria-live="polite"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-submit">Send Message</button>
                    
                    <!-- Screen Reader Announcement Region -->
                    <div id="form-status" class="sr-only" aria-live="assertive"></div>
                </form>
            </div>
        </section>

    </main>

    <!-- Global Site Footer -->
    <footer class="site-footer" role="contentinfo">
        <div class="container footer-inner">
            <p>&copy; 2026 AKSHAYA. All rights reserved.</p>
            <nav aria-label="Social Media Links">
                <ul class="social-links" role="list">
                    <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile">GitHub</a></li>
                    <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile">LinkedIn</a></li>
                    <li><a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter Profile">Twitter</a></li>
                </ul>
            </nav>
        </div>
    </footer>

</body>
</html>
